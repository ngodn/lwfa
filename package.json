{
  "name": "lwfa",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "literally work from anywhere: a Wayland compositor with a browser-native shell",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "config": "node scripts/gen-config.mjs",
    "fixtures": "cargo run -q -p lwfa-spring --bin gen-fixtures && cargo run -q -p lwfa-proto --bin gen-proto-fixtures",
    "test": "pnpm run config && pnpm run fixtures && vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --workspace",
    "test:all": "pnpm test && pnpm run test:rust",
    "typecheck": "pnpm run config && tsc --noEmit",
    "e2e:audio": "node --experimental-strip-types scripts/e2e-audio.mjs",
    "build": "pnpm --filter @lwfa/shell run build",
    "start": "pnpm --filter @lwfa/shell run preview",
    "engine:release": "cargo build --release -p lwfa-engine"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "smol-toml": "^1.7.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
