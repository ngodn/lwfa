+/* These flags live beside the volatile display modes and are protected by
+ * display_device_init. Remember intent across processes and host mode changes. */
+static BOOL canvas_same_geometry( const DEVMODEW *a, const DEVMODEW *b )
+{
+    return a->dmPelsWidth == b->dmPelsWidth && a->dmPelsHeight == b->dmPelsHeight &&
+           a->dmDisplayOrientation == b->dmDisplayOrientation;
+}
+
+static void canvas_write_follow( HKEY key, UINT index, BOOL follow )
+{
+    WCHAR name[32];
+    DWORD value = follow;
+    asciiz_to_unicode( name, index == ENUM_CURRENT_SETTINGS ? "CanvasCurrentFollow" : "CanvasRegistryFollow" );
+    set_reg_value( key, name, REG_DWORD, &value, sizeof(value) );
+}
+
+static BOOL canvas_read_follow( HKEY key, UINT index, const DEVMODEW *mode,
+                                const DEVMODEW *previous_physical )
+{
+    char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(DWORD)])];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    const char *name = index == ENUM_CURRENT_SETTINGS ? "CanvasCurrentFollow" : "CanvasRegistryFollow";
+    BOOL follow;
+
+    if (query_reg_ascii_value( key, name, value, sizeof(buffer) ) && value->Type == REG_DWORD &&
+        value->DataLength == sizeof(DWORD)) return !!*(DWORD *)value->Data;
+
+    follow = canvas_same_geometry( mode, previous_physical );
+    canvas_write_follow( key, index, follow );
+    return follow;
+}
