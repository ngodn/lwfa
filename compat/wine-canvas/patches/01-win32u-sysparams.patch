+/* Keep an overflowing DPI fraction in the existing 16-bit wire format.
+ * Continued fractions bound both fields while retaining the closest ratio. */
+static UINT canvas_pack_dpi( UINT numerator, UINT denominator )
+{
+    ULONGLONG n = numerator, d = denominator, p0 = 0, q0 = 1, p1 = 1, q1 = 0;
+    const ULONGLONG limit = 65535;
+    ULONGLONG p, q;
+
+    if (!d) return USER_DEFAULT_SCREEN_DPI;
+    while (d)
+    {
+        ULONGLONG a = n / d, p2 = p0 + a * p1, q2 = q0 + a * q1;
+        if (p2 > limit || q2 > limit)
+        {
+            ULONGLONG k = limit, error, previous_error;
+            if (p1) k = min( k, (limit - p0) / p1 );
+            if (q1) k = min( k, (limit - q0) / q1 );
+            p = p0 + k * p1;
+            q = q0 + k * q1;
+            if (!q || !p) { p = p1; q = q1; }
+            else if (q1 && p1)
+            {
+                ULONGLONG left = p * denominator, right = (ULONGLONG)numerator * q;
+                ULONGLONG old_left = p1 * denominator, old_right = (ULONGLONG)numerator * q1;
+                error = left > right ? left - right : right - left;
+                previous_error = old_left > old_right ? old_left - old_right : old_right - old_left;
+                if (previous_error * q < error * q1) { p = p1; q = q1; }
+            }
+            goto packed;
+        }
+        p0 = p1; q0 = q1; p1 = p2; q1 = q2;
+        a = n % d; n = d; d = a;
+    }
+    p = p1; q = q1;
+packed:
+    if (!p || !q) return USER_DEFAULT_SCREEN_DPI;
+    return ((q == 1 ? 0 : (UINT)q) << 16) | (UINT)p;
+}
