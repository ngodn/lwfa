+/* Compute the proposed destination before deriving visible and surface bounds.
+ * The stored presentation rectangle is committed only after SetWindowPos succeeds. */
+static BOOL get_position_present_rect( HWND hwnd, const struct window_rects *rects, RECT *present )
+{
+    const char *canvas_follow = getenv( "WINE_CANVAS_FOLLOW_HOST" );
+    struct window_rects previous;
+    UINT dpi = get_thread_dpi();
+
+    if (!get_present_rect( hwnd, present, dpi )) return FALSE;
+    if (canvas_follow && !strcmp( canvas_follow, "1" ) &&
+        get_window_rects( hwnd, COORDS_PARENT, &previous, dpi ) &&
+        EqualRect( present, &previous.client ) && EqualRect( &previous.window, &previous.client ))
+        *present = rects->client;
+    return TRUE;
+}
