+/* Preserve a custom virtual clipping interval when the physical monitor changes. */
+static int canvas_map_clip_edge( int value, double old_raw_center, double old_virtual_center,
+                                 double old_scale, double new_raw_center, double new_virtual_center,
+                                 double new_scale )
+{
+    double virtual = (value - old_raw_center) / old_scale + old_virtual_center;
+    double raw = (virtual - new_virtual_center) * new_scale + new_raw_center;
+    return raw < 0 ? raw - 0.5 : raw + 0.5;
+}
+
+static void canvas_update_clip( struct desktop *desktop, const struct monitor_info *old,
+                                const struct monitor_info *new )
+{
+    struct rectangle clip = desktop->shared->cursor.clip;
+    unsigned int flags = desktop->clip_flags;
+    int ow = old->raw.right - old->raw.left, oh = old->raw.bottom - old->raw.top;
+    int ovw = old->virt.right - old->virt.left, ovh = old->virt.bottom - old->virt.top;
+    int nw = new->raw.right - new->raw.left, nh = new->raw.bottom - new->raw.top;
+    int nvw = new->virt.right - new->virt.left, nvh = new->virt.bottom - new->virt.top;
+    double old_scale, new_scale;
+
+    if (ow <= 0 || oh <= 0 || ovw <= 0 || ovh <= 0 || nw <= 0 || nh <= 0 || nvw <= 0 || nvh <= 0) return;
+    old_scale = (double)ow / ovw < (double)oh / ovh ? (double)ow / ovw : (double)oh / ovh;
+    new_scale = (double)nw / nvw < (double)nh / nvh ? (double)nw / nvw : (double)nh / nvh;
+    if (flags & (SET_CURSOR_NOCLIP | SET_CURSOR_FSCLIP)) clip = new->raw;
+    else
+    {
+        clip.left = canvas_map_clip_edge( clip.left, old->raw.left + ow / 2.0, old->virt.left + ovw / 2.0,
+                                         old_scale, new->raw.left + nw / 2.0, new->virt.left + nvw / 2.0, new_scale );
+        clip.right = canvas_map_clip_edge( clip.right, old->raw.left + ow / 2.0, old->virt.left + ovw / 2.0,
+                                          old_scale, new->raw.left + nw / 2.0, new->virt.left + nvw / 2.0, new_scale );
+        clip.top = canvas_map_clip_edge( clip.top, old->raw.top + oh / 2.0, old->virt.top + ovh / 2.0,
+                                        old_scale, new->raw.top + nh / 2.0, new->virt.top + nvh / 2.0, new_scale );
+        clip.bottom = canvas_map_clip_edge( clip.bottom, old->raw.top + oh / 2.0, old->virt.top + ovh / 2.0,
+                                           old_scale, new->raw.top + nh / 2.0, new->virt.top + nvh / 2.0, new_scale );
+    }
+    set_clip_rectangle( desktop, &clip, flags, 0 );
+}
