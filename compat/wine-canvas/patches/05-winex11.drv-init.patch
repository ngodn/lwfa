+                              ((data->current_state.rect.bottom - data->current_state.rect.top) -
+                               (rect.bottom - rect.top)) / 2 );
+        }
+        else OffsetRect( &rect, data->rects.client.left - data->rects.visible.left,
+                         data->rects.client.top - data->rects.visible.top );
         release_win_data( data );
     }
 
