{
  // shadcn's registry components, checked with the settings they were written
  // against. They are vendored: the CLI overwrites them on every `shadcn add`,
  // so bending them to this repo's stricter flags would be undone by the next
  // update. Our own code is checked by the root tsconfig, which keeps
  // exactOptionalPropertyTypes and the unused-symbol checks on.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "exclude": [],
  "include": ["src/components/ui/**/*.tsx"]
}
