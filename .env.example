# Copy to .env and set a password of your own.
#
#   cp .env.example .env
#   sed -i "s|^AUTH_PASS=.*|AUTH_PASS=$(openssl rand -hex 16)|" .env
#
# .env is gitignored. Never commit a real password.

# Shared secret the shell must present to reach the engine.
#
# Required whenever the engine listens anywhere. Keep it stable so a bookmarked
# URL on a phone or tablet keeps working across restarts.
AUTH_PASS=change-me

# --- Ports ----------------------------------------------------------------
# One port. The engine serves the page and its own socket together: a
# WebSocket upgrade is the protocol, everything else is a file.
#
#   6733  the port you type on a phone or tablet, and the only one to open
#
# Use 0.0.0.0 to reach it from other devices; 127.0.0.1 keeps it on this
# machine only. There is NO encryption, so only expose it on a network you
# trust, and tunnel it anywhere else.
LWFA_SHELL_ADDR=127.0.0.1:6733

# During development Vite serves the page on 6733 instead, so move the engine
# up one and let Vite proxy /engine back to it. scripts/dev-nested.sh sets this
# for you; it is here so a hand-run engine can match.
#
#   LWFA_SHELL_ADDR=127.0.0.1:6734
