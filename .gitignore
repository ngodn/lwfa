# Rust
/target/

# Node
node_modules/
*.tsbuildinfo

# Generated parity fixtures.
#
# Deliberately NOT committed. They are derived from crates/lwfa-spring, and a
# committed copy would let the Rust implementation drift while the test kept
# passing against a stale snapshot. `pnpm test` regenerates them first.
/fixtures/rust.*.tsv

# Editors
.idea/
.vscode/
*.swp

# Generated protocol fixtures. fixtures/proto/ IS committed (it is the canonical
# wire format, and a diff on it is a protocol change worth reviewing), but the
# TypeScript round-trip output is derived and regenerated by `pnpm test`.
/fixtures/proto-from-ts/

# Generated from configs/defaults.toml. Not committed, for the same reason as
# the fixtures above: a committed copy would let defaults.toml drift while
# everything kept building against a stale snapshot. `pnpm run config` writes it.
/packages/shell/src/generated/

# Playwright MCP scratch output from browser verification runs.
/.playwright-mcp/

# Local secrets. AUTH_PASS lives here; never commit it.
# See .env.example for the format.
.env
.env.local
