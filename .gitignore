# Rust
/target/

# Node
node_modules/
*.tsbuildinfo

# Generated parity fixtures.
#
# Deliberately NOT committed. They are derived from crates/lwfa-spring, and a
# committed copy would let the Rust implementation drift while the test kept
# passing against a stale snapshot. `pnpm test` regenerates them first.
/fixtures/rust.*.tsv

# Editors
.idea/
.vscode/
*.swp

# Generated protocol fixtures. fixtures/proto/ IS committed (it is the canonical
# wire format, and a diff on it is a protocol change worth reviewing), but the
# TypeScript round-trip output is derived and regenerated by `pnpm test`.
/fixtures/proto-from-ts/

# Generated from configs/defaults.toml. Not committed, for the same reason as
# the fixtures above: a committed copy would let defaults.toml drift while
# everything kept building against a stale snapshot. `pnpm run config` writes it.
/packages/shell/src/generated/

# Playwright MCP scratch output from browser verification runs.
/.playwright-mcp/

# Local secrets. AUTH_PASS lives here; never commit it.
# See .env.example for the format.
.env
.env.local

# Vite build output for the shell.
/packages/shell/dist/

# Deployment configs filled in for one particular machine. The templates in
# deploy/ are committed and generic; a copy with your real hostname, LAN
# address and certificate paths belongs here and nowhere else.
/deploy/local/

# Built release artifacts. Tens of megabytes each, rebuildable from a tag by
# scripts/package.sh, and belonging on a releases page rather than in history.
/releases/*.run

# Raw screen recordings. docs/demo.mp4 is the transcoded copy the README
# embeds and is committed; the originals are hundreds of megabytes and are
# above GitHub's per-file limit.
/docs/ScreenRecording*.mp4

# Certificates generated by deploy/docker/make-cert.sh. The key is private and
# the certificate names one particular machine, so neither belongs here.
/deploy/docker/certs/

# The accounts database. Machine-local, holds password hashes, and belongs to
# the machine it authenticates for. Its location is XDG_STATE_HOME by default;
# this covers a stray LWFA_DB pointed at the repo.
*.db
*.db-shm
*.db-wal
